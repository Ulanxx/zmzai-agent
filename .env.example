# 服务端配置。不要把任何真实值提交到仓库。
NODE_ENV=development
APP_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://.../zmzai_agent
AUTH_SECRET=replace-with-the-shared-zmzai-auth-secret
SESSION_COOKIE_NAME=muzhi_session
SESSION_COOKIE_DOMAIN=.zmzai.cloud

# 下一批 PI / Sandbox Adapter 使用。浏览器不可读取这些变量。
RELAY_AGENT_URL=https://m.zmzai.cloud
RELAY_AGENT_SERVICE_SECRET_CURRENT=replace-with-agent-service-secret
RELAY_AGENT_SERVICE_SECRET_PREVIOUS=
SANDBOX_AGENT_URL=https://z.zmzai.cloud
SANDBOX_AGENT_SERVICE_SECRET_CURRENT=replace-with-sandbox-service-secret
SANDBOX_AGENT_SERVICE_SECRET_PREVIOUS=
# exec 工具允许的程序白名单（逗号分隔，覆盖默认列表；与 z.zmzai.cloud 的 SANDBOX_AGENT_ALLOWED_PROGRAMS 保持一致）。
EXEC_ALLOWED_PROGRAMS=
